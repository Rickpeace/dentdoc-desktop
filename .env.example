# DentDoc Desktop App - Environment Configuration
#
# Diese Datei ist eine VORLAGE und wird eingecheckt.
# Niemals echte Tokens hier eintragen — das Repository ist oeffentlich.
# Echte Werte gehoeren in .env (gitignored) bzw. in die GitHub-Secrets
# des Release-Workflows (.github/workflows/release.yml).

# API Base URL - PRODUKTION (wird beim Build verwendet)
API_URL=https://dentdoc.de/

# Railway Upload-Proxy (AssemblyAI-Key bleibt auf Railway, nicht im Desktop)
# Der Proxy streamt Audio direkt zu AssemblyAI durch (kein Zwischenspeichern)
UPLOAD_PROXY_URL=https://dentdoc-upload-proxy.up.railway.app
UPLOAD_PROXY_TOKEN=hier_echten_token_einsetzen

# WebSocket-Relay fuer die iPhone-Aufnahme (anderer Dienst als der Upload-Proxy)
AUDIO_RELAY_URL=wss://dentdoc-desktop-production-a7a1.up.railway.app

# Fuer lokale Entwicklung: .env.local anlegen mit z. B.
#   API_URL=http://localhost:3000/
# .env.local ueberschreibt .env und wird nicht committed.
